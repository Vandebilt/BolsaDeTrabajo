<body>
    <!-- Evita que se recargue la pagina -->
    <script type="text/javascript">
        if (window.history.replaceState) { // verificamos disponibilidad
            window.history.replaceState(null, null, window.location.href);
        }
    </script>
    <!-- Fin Evita que se recargue la pagina -->
    <!-- Mensajes de alerta -->
    <script type="text/javascript">
        function mostrarConfirmacion(title, text, pantalla, metodoConfirmacion, modalError) {
            Swal.fire({
                title: title,
                text: text,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#333',
                cancelButtonColor: '#dc3545',
                confirmButtonText: 'Confirmar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    // El usuario hizo clic en Aceptar
                    var parametros = {
                        pConfirmacion: 'Confirmación'
                    };
                } else {
                    // El usuario hizo clic en Cancelar
                    var parametros = {
                        pConfirmacion: '',
                    };
                    localStorage.removeItem("_Id") // Parametro exclusivo de modulo Productos
                    mostrarModal(modalError)
                }
                // Enviar una solicitud AJAX al método en el servidor 
                $.ajax({
                    type: "POST",
                    url: `${pantalla}.aspx/${metodoConfirmacion}`,
                    data: JSON.stringify(parametros),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        if (response.d == "200") {
                            // La operación se realizó con éxito 
                            alertaRecarga('La información ha sido actualizada satisfactoriamente',
                                'success')
                        }
                        else {
                            // Limpia la variable almacenada del producto
                            localStorage.removeItem("_Id");
                            // La operación no se realizó
                            alertaRecarga(response.d, 'error', '')
                        }
                    },
                    error: function (error) {
                        // Manejar el error aquí
                        alert(`Ocurrió un error al redireccionar al método en el servidor: ${error}`);
                    }
                });
            });
        }
        function mostrarMensaje(titulo, icono, urlDestino) {
            Swal.fire({
                title: titulo,
                text: "Haga clic para continuar.",
                icon: icono,
                allowOutsideClick: false,
                confirmButtonText: "Aceptar",
                confirmButtonColor: "#333"

            }).then(function () {
                // Solo redirigir si la URL no es null
                if (urlDestino) {
                    window.location.href = urlDestino;
                }
            });
        }
    </script>
    <!-- Fin Mensajes de alerta -->
    <!-- Abrir ventana modal -->
    <script type="text/javascript">
        function abrirModal(ventana) {
            $(ventana).modal('show');
        }
    </script>
    <!-- Fin Abrir ventana modal -->
    <!-- Alerta de confirmación -->
    <script type="text/javascript">
        function showConfirmation(el) {
            var btn = el.closest ? el.closest('a') : el;

            Swal.fire({
                title: '¿Desea confirmar la eliminación del registro seleccionado?',
                text: "Seleccione una de las opciones",
                icon: 'question',
                allowOutsideClick: false,
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, Continuar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    var href = btn.getAttribute('href') || '';
                    var m = href.match(/__doPostBack\('([^']+)'(?:,'([^']*)')?\)/);
                    sessionStorage.setItem('BT_Sustentante_WasPostback', 'true');

                    if (m) {
                        __doPostBack(m[1], m[2] || '');
                    } else {
                        btn.removeAttribute('onclick');
                        btn.click();
                    }
                }
            });
            // --- 2. NUEVA FUNCIÓN (solo para la imagen) ---
            function confirmDeleteImage(el, hiddenFieldId) {
                var btn = el.closest ? el.closest('a') : el;

                Swal.fire({
                    title: '¿Desea borrar la fotografía?', // Título específico
                    text: "La imagen se eliminará y deberá subir una nueva.", // Texto específico
                    icon: 'warning', // Icono más apropiado
                    allowOutsideClick: false,
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, Borrar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // --- INICIO: CÓDIGO DE LIMPIEZA ---
                        const previewImage = document.getElementById('previewImage');
                        const previewContainer = document.getElementById('previewContainer');
                        const srcFile = document.getElementById('srcFile');
                        const hfCroppedImage = document.getElementById('hfCroppedImage');
                        if (previewImage) previewImage.src = '';
                        if (previewContainer) previewContainer.classList.add('d-none');
                        if (hfCroppedImage) hfCroppedImage.value = '';
                        if (srcFile) srcFile.classList.remove('d-none');
                        // --- FIN: CÓDIGO DE LIMPIEZA ---
                        // --- Lógica para el postback (copiada de tu función) ---
                        var href = btn.getAttribute('href') || '';
                        var m = href.match(/__doPostBack\('([^']+)'(?:,'([^']*)')?\)/);
                        if (m) {
                            __doPostBack(m[1], m[2] || '');
                        } else {
                            btn.removeAttribute('onclick');
                            btn.click();
                        }
                    }
                });
                // Importante: siempre retornar false
            }
            return false;
        }
    </script>
    <!-- Fin Alerta de confirmación -->
    <!-- Mensajes de alerta recarga -->
    <script>
        function alertaRecarga(titulo, icono) {
            Swal.fire({
                title: titulo,
                icon: icono,
                showDenyButton: false,
                showCancelButton: false,
                confirmButtonText: 'Aceptar',
                confirmButtonColor: '#333'
            }).then((result) => {
                /* Read more about isConfirmed, isDenied below */
                if (result.isConfirmed) {
                    location.reload();
                }
            })
        }
    </script>
    <!-- Fin Mensajes de alerta recarga -->
