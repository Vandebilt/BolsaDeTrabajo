    <script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
    <script src="Recursos/js/alerta.js"></script>
    <!-- Select2 -->
    <script type="text/javascript">
        $(function () {
            // Inicializa todos los controles select2 con la clase "select2-custom"
            $(".select2-custom").each(function () {
                // Verificando si su elemento padre tiene la clase de un modal
                // Si es así, asignamos el modal como el dropdownParent, de lo contrario, dejamos el dropdownParent como null
                var dropdownParent = $(this).closest('.modal').length > 0 ? $("#ModalNuevo") : null;
                $(this).select2({
                    // Cambiando mensajes a español
                    language: {
                        noResults: function () {
                            return "No hay resultados";
                        },
                        searching: function () {
                            return "Buscando...";
                        }
                    },
                    dropdownParent: dropdownParent // Para que funcione el control con select2 en el modal
                });
            });
            // Agrega un placeholder personalizado al campo de búsqueda de cada control select2 al abrirlo
            $(".select2-custom").on("select2:open", function (event) {
                $('input.select2-search__field').attr('placeholder', 'Buscar');
            });
        });
    </script>
    <!-- Fin Select2 -->
    <div id="fade-overlay"></div>
    <div id="overlayCarga" class="loader-overlay">
        <div class="loader"></div>
